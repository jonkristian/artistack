    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.13",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.1",
    "uplot": "^1.6.32",
    "valibot": "^1.2.0"
  }
