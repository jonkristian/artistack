# --- Required in production -------------------------------------------------

# Public URL of the site. Used for auth trusted origins, and for the absolute
# video/preview URLs in the clip publish payload — get this wrong and n8n
# receives links pointing at localhost.
BETTER_AUTH_BASE_URL=https://your-domain.com

# adapter-node reads this for form-action origin checks. Set it to the same
# value as BETTER_AUTH_BASE_URL.
ORIGIN=https://your-domain.com

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-here

# Who is calling, when the app sits behind a reverse proxy. Set in nixpacks.toml
# for the Coolify build, so this is only worth touching if you deploy some other
# way or have a different number of proxies in front.
#
# XFF_DEPTH counts hops, from the app outwards:
#   Coolify alone                 XFF_DEPTH=1
#   Cloudflare in front of it     XFF_DEPTH=2   <- what this project uses
#
# Too low and you log the proxy instead of the visitor. Too high and the adapter
# throws, which is caught as "no address" — wrong, but never someone else's.
# Left unset entirely, the sign-up rate limit still holds, as one allowance for
# the whole site rather than one each.
# ADDRESS_HEADER=x-forwarded-for
# XFF_DEPTH=2

# --- Optional ---------------------------------------------------------------

# Where the SQLite file lives. Read by both the app and scripts/migrate.mjs.
# Defaults to data/artistack.db, relative to the working directory.
# DATABASE_PATH=data/artistack.db

# Pins the caption font instead of probing FONT_PREFERENCES with fc-match.
# Only set this to a family you have confirmed exists in the running container:
#   fc-match -f '%{family}' "Roboto Condensed"
# CLIP_FONT_FAMILY=Roboto Condensed

# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASSWORD=secret
# SMTP_FROM_ADDRESS=noreply@example.com  # optional, defaults to SMTP_USER
# SMTP_FROM_NAME=My Site                 # optional, defaults to 'Artistack'
# SMTP_TLS=true                          # optional, defaults to true
